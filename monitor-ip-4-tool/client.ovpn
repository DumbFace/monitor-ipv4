remote {ipv4} 1025
float
nobind
proto tcp-client
dev tun
sndbuf 0
rcvbuf 0
keepalive 10 30


# for OpenVPN 2.4 or older
comp-lzo yes
# for OpenVPN 2.4 or newer
;compress lzo

auth-user-pass "{directory}"
client
auth SHA1
ignore-unknown-option cipher data-ciphers
cipher AES-128-CBC
data-ciphers AES-128-CBC
remote-cert-tls server 
<ca>
{ca}
</ca>

#
# Update client certificate and key if necessary
#
<cert>
{cert}
</cert>

<key>
{key}
</key>

