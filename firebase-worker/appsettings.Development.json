{
  "firebase": {
    "node": {
      "iplog": "IpLog"
    }
  },
  "rabbitmq": {
    "Host": "localhost",
    "UserName": "admin",
    "Password": "admin",
    "Port": "5672"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Verbose"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "restrictedToMinimumLevel": "Verbose",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}