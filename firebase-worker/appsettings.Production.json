{
  "firebase": {
    "node": {
      "iplog": "IpLog"
    }
  },
  "rabbitmq": {
    "Host": "172.19.0.20",
    "UserName": "guest",
    "Password": "guest",
    "Port": "5672"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "restrictedToMinimumLevel": "Information"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log.txt",
          "restrictedToMinimumLevel": "Error",
          "rollingInterval": "Day"
        }
      }
    ]
  }
}