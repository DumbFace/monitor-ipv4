<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <RootNamespace>monitor_ip_4_tool</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <None Update="appsettings.Development.json" Condition="'$(Configuration)' == 'Debug'">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>

        <None Update="appsettings.json" Condition="'$(Configuration)' == 'Production'">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>

        <None Include="..\Shared\*.txt;..\Shared\client.ovpn;..\Shared\sharedsettings.json">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Shared\Shared.csproj" />
    </ItemGroup>

</Project>